# Google OAuth – Sign in / Sign up with Google (frontend uses only Client ID)
# Get from: https://console.cloud.google.com/apis/credentials
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Local backend – use when running Laravel locally so Gig States etc work (e.g. php artisan serve)
# REACT_APP_HOST_API=http://127.0.0.1:8000/api/
